{
  "version": 3,

  "configurePresets": [
    {
      "name": "linux-gcc-debug-proxy",
      "inherits": "linux-gcc-debug",
      "cacheVariables": {
        "ENABLE_X_DEBUG": "ON"
      },
      "environment": {
        // 代理 wsl不要用127.0.0.0:8090 要用宿主机的地址
        "http_proxy": "http://127.0.0.1:7890",
        "https_proxy": "http://127.0.0.1:7890"
      }
    },
    {
      "name": "mac-clang-debug-proxy",
      "inherits": "mac-clang-debug",
      "cacheVariables": {
        "ENABLE_X_DEBUG": "ON"
      },
      "environment": {
        // 代理 wsl不要用127.0.0.0:8090 要用宿主机的地址
        "http_proxy": "http://127.0.0.1:7890",
        "https_proxy": "http://127.0.0.1:7890"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "linux-gcc-debug-proxy",
      "configurePreset": "linux-gcc-debug-proxy",
      // 编译并行数，默认用 14 所有cpu都顶满了 建议4-6
      "jobs": 10
    }
  ]
}
